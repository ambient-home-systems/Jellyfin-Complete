{
  "name": "maverick-jellyfin-complete",
  "version": "0.7.0",
  "description": "Kometa-style seasonal collections for Jellyfin, with a plan → review → apply pipeline.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen:jellyfin": "openapi-typescript spec/jellyfin-openapi.json -o src/clients/jellyfin/schema.d.ts",
    "db:generate": "drizzle-kit generate",
    "imdb:snapshot": "tsx scripts/imdb-snapshot.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "croner": "^11.0.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "htmx.org": "^2.0.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  }
}
